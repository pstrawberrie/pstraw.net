---
import * as LJS from "@node/littlejsengine/dist/littlejs.esm.js";
import BaseLayout from "@layouts/BaseLayout.astro";

// @TODO put this into a component, use client:only or similar! looks like it's working ish so far
function gameRender() {
  // precreate variables to avoid overhead
  const pos = LJS.vec2(),
    size = LJS.vec2(),
    color = LJS.rgb();
  for (let i = 2e3; i--; ) {
    // use math to generate random star positions
    const offset = LJS.time * (9 + (i ** 2.1 % 15)) + i ** 2.3;
    pos.x = (offset % 70) - 35;
    pos.y = i / 110 - 9;
    size.x = size.y = (i % 0.11) + 0.07;
    color.set(1, 1, 1, LJS.sin(i) ** 4);
    LJS.drawRect(pos, size, color);
  }
}

