---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroGame from "@components/games/HeroGame.svelte";
---

<BaseLayout>
  <section id="straw-hero">
    <HeroGame client:only />
  </section>
  <div class="test-space"></div>
</BaseLayout>

<style lang="scss">
  @use "@css/util";

  #straw-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100dvh;
    margin: 0 auto;
    padding: var(--nav-height) var(--space-page-h) 4vh;
    background: rgba(255, 0, 255, 0.1);
  }

  #hero-game-overlay {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100dvh;
    z-index: 500;
  }

  // Testing
  .test-space {
    padding: 10rem 0;
  }
</style>
